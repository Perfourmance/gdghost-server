# 로컬 환경변수 예시. 복사해서 쓰세요: cp .env.example .env
# .env는 git에 올라가지 않습니다. 실제 비밀번호는 .env에만 적습니다.

DB_URL=jdbc:mysql://127.0.0.1:3307/gdghost?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=gdghost
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 메일(선택). 비워 두면 보내지 않고 서버 로그에 찍는다. Gmail은 앱 비밀번호
MAIL_USERNAME=
MAIL_PASSWORD=

# 디스코드 웹훅(선택). 비워 두면 보내지 않고 서버 로그에 찍는다. 채널 설정 → 연동 → 웹후크에서 복사
DISCORD_MEMBER_WEBHOOK_URL=
DISCORD_STAFF_WEBHOOK_URL=
DISCORD_DEV_WEBHOOK_URL=

# 서비스 첫 시작(선택). 준비용 초대 코드 · 개발자 아이디(쉼표 구분)
BOOTSTRAP_INVITE_CODE=
BOOTSTRAP_GENERATION=
BOOTSTRAP_DEV_LOGIN_IDS=

# 프론트 주소. 메일 링크에 쓴다. 운영은 필수
WEB_URL=http://localhost:3000

# 웹 푸시 VAPID 키(선택, 운영은 필수). 비워 두면 보내지 않고 서버 로그에 찍는다. npx web-push generate-vapid-keys 로 만든다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Workers AI 임베딩(선택, 운영은 필수). 비워 두면 호출하지 않는다. Cloudflare 대시보드 Workers AI → Use REST API
CLOUDFLARE_ACCOUNT_ID=
WORKERS_AI_API_TOKEN=
