# 로컬 환경변수 예시. 복사해서 쓰세요: cp .env.example .env
# .env는 git에 올라가지 않습니다. 실제 비밀번호는 .env에만 적습니다.

DB_URL=jdbc:mysql://127.0.0.1:3307/gdghost?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=gdghost
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 메일(선택). 비워 두면 보내지 않고 서버 로그에 찍는다. Gmail은 앱 비밀번호
MAIL_USERNAME=
MAIL_PASSWORD=

# 서비스 첫 시작(선택). 준비용 초대 코드 · 개발자 아이디(쉼표 구분)
BOOTSTRAP_INVITE_CODE=
BOOTSTRAP_GENERATION=
BOOTSTRAP_DEV_LOGIN_IDS=
